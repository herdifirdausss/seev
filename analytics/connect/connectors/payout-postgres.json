{
  "name": "seev-payout-postgres-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "__SOURCE_DB_HOST__",
    "database.port": "__SOURCE_DB_PORT__",
    "database.user": "__SOURCE_DB_USER__",
    "database.password": "__SOURCE_DB_PASSWORD__",
    "database.dbname": "seev_payout",
    "topic.prefix": "seev.cdc.payout",
    "plugin.name": "pgoutput",
    "snapshot.mode": "initial",
    "publication.name": "seev_analytics_payout_pub",
    "publication.autocreate.mode": "disabled",
    "slot.name": "seev_analytics_payout_slot",
    "slot.drop.on.stop": "false",
    "table.include.list": "public.payout_requests,public.payout_vendor_calls",
    "column.include.list": "public.payout_requests.id,public.payout_requests.user_id,public.payout_requests.amount,public.payout_requests.currency,public.payout_requests.vendor,public.payout_requests.status,public.payout_requests.hold_tx_id,public.payout_requests.settle_tx_id,public.payout_requests.vendor_ref,public.payout_requests.fee_quote_id,public.payout_requests.fee_amount,public.payout_requests.fee_gateway,public.payout_requests.request_id,public.payout_requests.merchant_tenant_id,public.payout_requests.downstream_key,public.payout_requests.created_at,public.payout_requests.updated_at,public.payout_vendor_calls.id,public.payout_vendor_calls.payout_request_id,public.payout_vendor_calls.vendor,public.payout_vendor_calls.attempt,public.payout_vendor_calls.resp_status,public.payout_vendor_calls.outcome,public.payout_vendor_calls.created_at",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT 1",
    "provide.transaction.metadata": "true",
    "schema.history.internal.kafka.topic": "seev.analytics.schema-history.payout",
    "schema.history.internal.kafka.bootstrap.servers": "redpanda:9092",
    "transforms": "unwrap,pseudonymize,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.tombstone.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,table,lsn,source.ts_ms,db,schema,txId",
    "transforms.pseudonymize.type": "com.seev.analytics.PseudonymizeField$Value",
    "transforms.pseudonymize.fields": "user_id,customer_id,merchant_internal_id",
    "transforms.pseudonymize.salt.file": "/run/secrets/analytics_pseudonym_salt",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "seev\\.cdc\\.payout\\.(.*)",
    "transforms.route.replacement": "seev.cdc.payout.$1.v1",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "none",
    "errors.log.enable": "true"
  }
}
