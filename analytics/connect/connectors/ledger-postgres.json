{
  "name": "seev-ledger-postgres-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "__SOURCE_DB_HOST__",
    "database.port": "__SOURCE_DB_PORT__",
    "database.user": "__SOURCE_DB_USER__",
    "database.password": "__SOURCE_DB_PASSWORD__",
    "database.dbname": "seev_ledger",
    "topic.prefix": "seev.cdc.ledger",
    "plugin.name": "pgoutput",
    "snapshot.mode": "initial",
    "publication.name": "seev_analytics_ledger_pub",
    "publication.autocreate.mode": "disabled",
    "slot.name": "seev_analytics_ledger_slot",
    "slot.drop.on.stop": "false",
    "table.include.list": "public.accounts,public.account_balances,public.ledger_transactions,public.ledger_entries,public.fee_quotes",
    "column.include.list": "public.accounts.id,public.accounts.owner_type,public.accounts.type,public.accounts.currency,public.accounts.pocket_code,public.accounts.system_qualifier,public.accounts.status,public.accounts.created_at,public.accounts.updated_at,public.account_balances.account_id,public.account_balances.balance,public.account_balances.allow_negative,public.account_balances.updated_at,public.ledger_transactions.id,public.ledger_transactions.type,public.ledger_transactions.status,public.ledger_transactions.amount,public.ledger_transactions.currency,public.ledger_transactions.source_account_id,public.ledger_transactions.destination_account_id,public.ledger_transactions.external_ref,public.ledger_transactions.gateway,public.ledger_transactions.request_id,public.ledger_transactions.closed_by_tx_id,public.ledger_transactions.closed_reason,public.ledger_transactions.created_at,public.ledger_transactions.updated_at,public.ledger_entries.id,public.ledger_entries.transaction_id,public.ledger_entries.account_id,public.ledger_entries.direction,public.ledger_entries.amount,public.ledger_entries.balance_after,public.ledger_entries.created_at,public.fee_quotes.id,public.fee_quotes.user_id,public.fee_quotes.transaction_type,public.fee_quotes.gateway,public.fee_quotes.currency,public.fee_quotes.amount,public.fee_quotes.fee_amount,public.fee_quotes.fee_gateway,public.fee_quotes.expires_at,public.fee_quotes.consumed_at,public.fee_quotes.consumed_by_ref,public.fee_quotes.created_at",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT 1",
    "provide.transaction.metadata": "true",
    "schema.history.internal.kafka.topic": "seev.analytics.schema-history.ledger",
    "schema.history.internal.kafka.bootstrap.servers": "redpanda:9092",
    "transforms": "unwrap,pseudonymize,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.tombstone.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,table,lsn,source.ts_ms,db,schema,txId",
    "transforms.pseudonymize.type": "com.seev.analytics.PseudonymizeField$Value",
    "transforms.pseudonymize.fields": "user_id,customer_id,merchant_internal_id",
    "transforms.pseudonymize.salt.file": "/run/secrets/analytics_pseudonym_salt",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "seev\\.cdc\\.ledger\\.(.*)",
    "transforms.route.replacement": "seev.cdc.ledger.$1.v1",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "none",
    "errors.log.enable": "true"
  }
}
