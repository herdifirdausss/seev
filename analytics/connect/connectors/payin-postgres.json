{
  "name": "seev-payin-postgres-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "__SOURCE_DB_HOST__",
    "database.port": "__SOURCE_DB_PORT__",
    "database.user": "__SOURCE_DB_USER__",
    "database.password": "__SOURCE_DB_PASSWORD__",
    "database.dbname": "seev_payin",
    "topic.prefix": "seev.cdc.payin",
    "plugin.name": "pgoutput",
    "snapshot.mode": "initial",
    "publication.name": "seev_analytics_payin_pub",
    "publication.autocreate.mode": "disabled",
    "slot.name": "seev_analytics_payin_slot",
    "slot.drop.on.stop": "false",
    "table.include.list": "public.payin_topup_intents,public.payin_webhook_events",
    "column.include.list": "public.payin_topup_intents.id,public.payin_topup_intents.reference,public.payin_topup_intents.user_id,public.payin_topup_intents.amount,public.payin_topup_intents.currency,public.payin_topup_intents.vendor,public.payin_topup_intents.status,public.payin_topup_intents.settled_event_id,public.payin_topup_intents.expires_at,public.payin_topup_intents.request_id,public.payin_topup_intents.merchant_tenant_id,public.payin_topup_intents.downstream_key,public.payin_topup_intents.created_at,public.payin_topup_intents.updated_at,public.payin_webhook_events.id,public.payin_webhook_events.vendor,public.payin_webhook_events.vendor_event_id,public.payin_webhook_events.external_ref,public.payin_webhook_events.user_id,public.payin_webhook_events.amount,public.payin_webhook_events.currency,public.payin_webhook_events.status,public.payin_webhook_events.request_id,public.payin_webhook_events.merchant_tenant_id,public.payin_webhook_events.created_at,public.payin_webhook_events.updated_at",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT 1",
    "provide.transaction.metadata": "true",
    "schema.history.internal.kafka.topic": "seev.analytics.schema-history.payin",
    "schema.history.internal.kafka.bootstrap.servers": "redpanda:9092",
    "transforms": "unwrap,pseudonymize,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.tombstone.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,table,lsn,source.ts_ms,db,schema,txId",
    "transforms.pseudonymize.type": "com.seev.analytics.PseudonymizeField$Value",
    "transforms.pseudonymize.fields": "user_id,customer_id,merchant_internal_id",
    "transforms.pseudonymize.salt.file": "/run/secrets/analytics_pseudonym_salt",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "seev\\.cdc\\.payin\\.(.*)",
    "transforms.route.replacement": "seev.cdc.payin.$1.v1",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "none",
    "errors.log.enable": "true"
  }
}
