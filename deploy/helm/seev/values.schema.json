{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "appNamespace": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "dataNamespace": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "egressNamespace": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "edgeNamespace": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "image", "identity", "replicas", "ports", "resources"],
        "properties": {
          "enabled": {"type": "boolean"},
          "image": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^(sha256:.*)?$"},
          "egressProxyRequired": {"type": "boolean"},
          "replicas": {"type": "integer", "minimum": 1, "maximum": 10},
          "ports": {"type": "array", "minItems": 1},
          "resources": {"type": "object"}
        }
      }
    },
    "egress": {
      "type": "object",
      "properties": {
        "allowedDomains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "edgeKubernetesAPICIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"}
        },
        "edgeKubernetesAPIPorts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    }
  }
}
