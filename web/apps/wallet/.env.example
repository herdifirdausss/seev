# Wallet application environment variables.
# Copy to .env.local for local overrides (git-ignored).
#
# Plan 56 (F0) is fixture-only — no live backend is required to run the app.
# The variables below are placeholders for the follow-up live-integration plan.

# ── Runtime (server-side only, never exposed to browser bundles) ─────────────

# Port the Next.js server listens on.
PORT=3000

# ── Future: live backend integration ─────────────────────────────────────────
# These will be required when the read-only Wallet plan integrates with live
# Auth and Gateway services (currently mocked by MSW fixtures).
#
# Public gateway URL reachable from the browser (same-origin proxy in prod).
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
#
# Auth service URL (server-side only — never exposed to browser).
# AUTH_SERVICE_URL=http://localhost:8082
