# Operator application environment variables.
# Copy to .env.local for local overrides (git-ignored).
#
# Plan 56 (F0) is fixture-only — no live backend is required to run the app.
# The authoritative operator console remains the Admin BFF embedded htmx UI.
# The variables below are placeholders for the follow-up operator plan.

# ── Runtime (server-side only, never exposed to browser bundles) ─────────────

# Port the Next.js server listens on.
PORT=3001

# ── Future: live backend integration ─────────────────────────────────────────
# These will be required when the Operator plan integrates with Admin BFF
# (currently mocked by MSW fixtures).
#
# Admin BFF URL (server-side only — never exposed to browser).
# ADMIN_BFF_URL=http://localhost:8095
